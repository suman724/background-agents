{
  "name": "open-inspect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prepare": "node -e \"if (process.env.CI) process.exit(0)\" && husky",
    "dev": "npm run dev:prepare && concurrently -k -n daemon,cp,web -c blue,green,yellow npm:dev:sandbox-daemon npm:dev:control-plane npm:dev:web",
    "dev:lan": "npm run dev:prepare && concurrently -k -n daemon,cp,web -c blue,green,yellow npm:dev:sandbox-daemon npm:dev:control-plane:lan npm:dev:web:lan",
    "dev:prepare": "npm run dev:bootstrap && npm run dev:build:sandbox && npm run dev:migrate",
    "dev:bootstrap": "./scripts/dev/bootstrap.sh",
    "dev:build:sandbox": "./scripts/dev/build-sandbox-image.sh",
    "dev:migrate": "./scripts/dev/migrate.sh",
    "dev:control-plane": "wrangler dev --config packages/control-plane/wrangler.dev.jsonc --persist-to .wrangler/state --port 8787",
    "dev:control-plane:lan": "wrangler dev --config packages/control-plane/wrangler.dev.jsonc --persist-to .wrangler/state --port 8787 --ip 0.0.0.0",
    "dev:sandbox-daemon": "node scripts/dev/sandbox-daemon.mjs",
    "dev:web": "npm run dev -w @open-inspect/web",
    "dev:web:lan": "npm run dev -w @open-inspect/web -- -H 0.0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.21.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "minimatch": "^10.2.4",
    "undici": "^7.24.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yaml,yml,css}": [
      "prettier --write"
    ],
    "packages/modal-infra/**/*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
